{
  "name": "bookkeeping",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/dsh-vite-shim.cjs ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && node --require ./scripts/dsh-vite-shim.cjs ./node_modules/vite/bin/vite.js build",
    "test": "node --require ./scripts/dsh-vite-shim.cjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --require ./scripts/dsh-vite-shim.cjs ./node_modules/vitest/vitest.mjs",
    "build:android": "pnpm build && cap sync android && node scripts/run-gradle.mjs assembleDebug",
    "build:android:release": "pnpm build && cap sync android && node scripts/run-gradle.mjs assembleRelease",
    "test:e2e": "node --require ./scripts/dsh-vite-shim.cjs scripts/run-playwright.mjs test",
    "test:e2e:install": "node --require ./scripts/dsh-vite-shim.cjs scripts/run-playwright.mjs install chromium"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "@playwright/test": "1.65.1"
  }
}
